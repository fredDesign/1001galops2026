---
import Layout from "@/layouts/main.astro"
import Nav from "@/components/Nav.astro"
import Hero from "@/components/Hero.astro"
import Marquee from "@/components/Marquee.astro"
import Experiences from "@/components/Experiences.astro"
import Pourquoi from "@/components/Pourquoi.astro"
import Yoga from "@/components/Yoga.astro"
import APropos from "@/components/APropos.astro"
import Lieu from "@/components/Lieu.astro"
import Galerie from "@/components/Galerie.astro"
import Temoignages from "@/components/Temoignages.astro"
import Contact from "@/components/Contact.astro"
import Footer from "@/components/Footer.astro"
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <Marquee />
    <Experiences />
    <Pourquoi />
    <Yoga />
    <APropos />
    <Lieu />
    <Galerie />
    <Temoignages />
    <Contact />
  </main>
  <Footer />
</Layout>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) e.target.classList.add("in")
      })
    },
    { threshold: 0.08 }
  )
  document.querySelectorAll(".reveal").forEach((el) => io.observe(el))
</script>
