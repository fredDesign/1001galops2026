---
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
  image?: string
  imageAlt?: string
  type?: "website" | "article"
  noindex?: boolean
}

const {
  title = "1001 Galops — Balades à cheval, yoga équestre & événements nature près de Paris",
  description = "Balades à cheval, yoga équestre et événements nature en forêt du vexin. À 45 minutes de Paris, ouvert 7j/7. Tous niveaux, dès 45€.",
  image = "images/og-image.jpg",
  imageAlt = "Cheval en liberté dans la forêt du Vexin — 1001 Galops",
  type = "website",
  noindex = false,
} = Astro.props

const siteUrl = "https://1001galops.fr"
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString()

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "TouristAttraction", "SportsActivityLocation"],
      "@id": `${siteUrl}/#business`,
      name: "1001 Galops",
      description:
        "Centre d'équitation nature proposant balades à cheval, yoga équestre et événements en forêt du vexin.",
      url: siteUrl,
      telephone: "+33678536430",
      email: "contact@1001galops.fr",
      image: `${siteUrl}/images/og-image.jpg`,
      logo: {
        "@type": "ImageObject",
        "@id": `${siteUrl}/#logo`,
        url: `${siteUrl}/images/logo.png`,
        contentUrl: `${siteUrl}/images/logo.png`,
        width: 600,
        height: 896,
        caption: "1001 Galops",
      },
      priceRange: "€€",
      currenciesAccepted: "EUR",
      paymentAccepted: "Cash, Credit Card",
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday",
          ],
          opens: "09:00",
          closes: "18:00",
        },
      ],
      address: {
        "@type": "PostalAddress",
        streetAddress: "Domaine de la Clairière",
        postalCode: "78440",
        addressLocality: "Drocourt",
        addressRegion: "Île-de-France",
        addressCountry: "FR",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: 49.056595859895005,
        longitude: 1.7794666918393576,
      },
      hasMap: "https://maps.google.com/?q=Drocourt+78440",
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: 4.9,
        reviewCount: 55,
        bestRating: 5,
      },
      amenityFeature: [
        { "@type": "LocationFeatureSpecification", name: "Parking gratuit", value: true },
      ],
      founder: { "@id": `${siteUrl}/#founder` },
      sameAs: ["https://www.facebook.com/1001galops"],
      areaServed: [
        { "@type": "AdministrativeArea", name: "Île-de-France" },
        { "@type": "AdministrativeArea", name: "Yvelines" },
        { "@type": "AdministrativeArea", name: "Val-d'Oise" },
        { "@type": "City", name: "Paris" },
        { "@type": "City", name: "Mantes-la-Jolie" },
        { "@type": "City", name: "Cergy" },
        { "@type": "City", name: "Versailles" },
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Expériences équestres",
        itemListElement: [
          {
            "@type": "Offer",
            name: "Balade à cheval",
            description: "Balades en forêt de 1h à 4h, tous niveaux.",
            price: "45",
            priceCurrency: "EUR",
            availability: "https://schema.org/InStock",
          },
          {
            "@type": "Offer",
            name: "Yoga équestre",
            description: "Séance de 2h mêlant yoga et connexion animale.",
            price: "75",
            priceCurrency: "EUR",
            availability: "https://schema.org/InStock",
          },
          {
            "@type": "Offer",
            name: "Événement sur mesure",
            description: "Team building, anniversaires et séminaires nature.",
            availability: "https://schema.org/InStock",
          },
          {
            "@type": "Offer",
            name: "Cours d'équitation de pleine nature",
            description: "Séances de 2h pour apprendre à se balader en autonomie.",
            price: "70",
            priceCurrency: "EUR",
            availability: "https://schema.org/InStock",
          },
        ],
      },
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#founder`,
      name: "Scheherazade Bracht",
      jobTitle: "Fondatrice & guide équestre",
      worksFor: { "@id": `${siteUrl}/#business` },
      hasCredential: [
        { "@type": "EducationalOccupationalCredential", "name": "BPJEPS Équitation" },
        { "@type": "EducationalOccupationalCredential", "name": "Tourisme Équestre" },
        { "@type": "EducationalOccupationalCredential", "name": "Soigneuse animalière" },
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "1001 Galops",
      inLanguage: ["fr", "en"],
    },
    {
      "@type": "Review",
      itemReviewed: { "@id": `${siteUrl}/#business` },
      author: { "@type": "Person", name: "David S." },
      reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: 5 },
      reviewBody: "Une expérience inoubliable ! Dès notre arrivée, nous avons été accueillis chaleureusement par Schéhérazade, dont la gentillesse et le professionnalisme font toute la différence. Ici, les chevaux vivent au plus près de leur état naturel, dans le respect de leurs besoins, et cela se ressent immédiatement.",
    },
    {
      "@type": "Review",
      itemReviewed: { "@id": `${siteUrl}/#business` },
      author: { "@type": "Person", name: "Jonathann VW." },
      reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: 5 },
      reviewBody: "Très belle expérience pour ma femme et moi. Organisation d'une balade pour une demande en mariage. Je recommande vivement, la monitrice est top et très disponible.",
    },
    {
      "@type": "Review",
      itemReviewed: { "@id": `${siteUrl}/#business` },
      author: { "@type": "Person", name: "Emeline M." },
      reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: 5 },
      reviewBody: "Mon mari avait réservé chez 1001 Galops pour nos 10 ans. Moi qui n'avait pas pratiqué l'équitation depuis un moment j'ai été ravie de m'occuper des chevaux. Et le plus c'est l'organisation en secret de sa demande qui a été parfaite !",
    },
    {
      "@type": "Review",
      itemReviewed: { "@id": `${siteUrl}/#business` },
      author: { "@type": "Person", name: "Dany M." },
      reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: 5 },
      reviewBody: "Rando et Yin Yoga ! Une première et magnifique expérience avec Shéhérazade pour les chevaux et Elisabeth pour le Yoga ! Une bouffée d'oxygène avec des chevaux bien dans leurs pattes !",
    },
    {
      "@type": "Review",
      itemReviewed: { "@id": `${siteUrl}/#business` },
      author: { "@type": "Person", name: "Mehdi D." },
      reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: 5 },
      reviewBody: "Beautiful scenery, amazing horses, and a brilliant instructor. A perfect day, highly recommended!",
    },
    {
      "@type": "Review",
      itemReviewed: { "@id": `${siteUrl}/#business` },
      author: { "@type": "Person", name: "Anne-Marie G." },
      reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: 5 },
      reviewBody: "La structure idéale pour une pratique pleine nature authentique et raisonnée ! Bien être animal et respect de la nature au programme. A travers une pratique régulière, je redécouvre le Vexin, tout en apprenant beaucoup grâce aux adorables chevaux de Shéhérazade !",
    },
    {
      "@type": "Review",
      itemReviewed: { "@id": `${siteUrl}/#business` },
      author: { "@type": "Person", name: "Aurélien" },
      reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: 5 },
      reviewBody: "Un moment magique à deux avec Schéhérazade et ses magnifiques chevaux ! Une chouette balade au calme, dans les chaumes et les bois à travers le Vexin à notre rythme, parfaitement adapté à nos allures de débutants.",
    },
    {
      "@type": "Review",
      itemReviewed: { "@id": `${siteUrl}/#business` },
      author: { "@type": "Person", name: "Laëtitia R." },
      reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: 5 },
      reviewBody: "Merci infiniment Schéhérazade pour cette balade à cheval, votre amabilité, votre passion transmise… La surprise a vraiment fait plaisir à monsieur. Au-delà de la promenade, avoir à s'occuper des chevaux avant et après rend l'expérience entière.",
    },
    {
      "@type": "Review",
      itemReviewed: { "@id": `${siteUrl}/#business` },
      author: { "@type": "Person", name: "Sarah R." },
      reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: 5 },
      reviewBody: "Une balade hors du temps où l'on prend vraiment le temps de s'occuper des chevaux avant la balade. Scheherazade est une accompagnatrice passionnante et très à l'écoute des cavaliers et des chevaux. Je la recommande les yeux fermés.",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Accueil",
          item: siteUrl,
        },
      ],
    },
  ],
}
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#143e54" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="keywords" content="balade à cheval, équitation nature, yoga équitation, événements équestres, EVJF, mariage, forêt du vexin, proche paris, activité nature, expérience équestre" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/images/fav/favicon.svg" />
    <link rel="icon" type="image/png" href="/images/fav/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/fav/apple-icon-180x180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl).toString()} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:site_name" content="1001 Galops" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, siteUrl).toString()} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Geo -->
    <meta name="geo.region" content="FR-78" />
    <meta name="geo.placename" content="Drocourt" />
    <meta name="geo.position" content="49.056595859895005;1.7794666918393576" />
    <meta name="ICBM" content="49.056595859895005, 1.7794666918393576" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
