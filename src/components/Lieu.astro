---
const infos = [
  { label: "Depuis Paris", value: "~45 min", detail: "A13 direction Normandie" },
  { label: "À proximité", value: "Vexin Français", detail: "Parc naturel régional" },
]

const lat = 49.056595859895005
const lng = 1.7794666918393576
const mapsUrl = `https://maps.google.com/?q=${lat},${lng}`
---

<section id="lieu" class="bg-cream py-24 lg:py-36 reveal" aria-labelledby="lieu-heading">
  <div class="max-w-350 mx-auto px-6 lg:px-10">

    <div class="grid lg:grid-cols-12 gap-10 items-end mb-16">
      <div class="lg:col-span-7">
        <div class="flex items-center gap-3 text-forest/70 text-[11px] uppercase tracking-[0.32em] mb-6 font-medium">
          <span class="w-10 h-px bg-terra shrink-0"></span>
          <span>Le lieu</span>
        </div>
        <h2 id="lieu-heading" class="font-display text-forest-deep text-[clamp(40px,7vw,108px)] leading-[0.95] tracking-tight">
          Au cœur<br/>
          <span class="font-editorial italic text-forest">du Vexin.</span>
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <p class="text-forest/75 text-base lg:text-lg leading-relaxed">
          Dans le Parc naturel régional du Vexin français, à Drocourt. Un cadre préservé, entouré de champs et de forêts, qui invite immédiatement au calme et à la déconnexion.
        </p>
      </div>
    </div>

    <div class="grid lg:grid-cols-12 gap-5 lg:gap-6">

      <!-- Map -->
      <div class="lg:col-span-7 relative aspect-4/3 lg:aspect-auto rounded-[28px] overflow-hidden bg-forest/5 border border-forest/12" aria-label="Vue de Drocourt, Vexin français">
        <img src="/images/drocourt.jpg" alt="Drocourt dans le Vexin français" class="w-full h-full object-cover" loading="lazy" />
      </div>

      <!-- Info card -->
      <div class="lg:col-span-5 bg-forest text-cream rounded-[28px] p-8 lg:p-10 flex flex-col gap-7 relative overflow-hidden">
        <div class="absolute -top-10 -right-10 w-48 h-48 rounded-full bg-blush/12 blur-2xl pointer-events-none"></div>
        <div class="relative">
          <div class="text-blush/85 text-[10px] uppercase tracking-[0.32em] mb-3 font-light">Adresse</div>
          <address class="font-display text-[26px] lg:text-[32px] leading-[1.1] not-italic">
            1001galops<br/><span class="italic">78440 Drocourt</span>
          </address>
          <div class="text-cream/60 text-sm mt-2 font-light">Parc naturel régional du Vexin français</div>
        </div>

        <div class="grid grid-cols-2 gap-6 pt-6 border-t border-cream/15">
          {infos.map((info) => (
            <div>
              <div class="text-blush/100 text-[9.5px] uppercase tracking-[0.3em] mb-2 font-light">{info.label}</div>
              <div class="font-display text-[26px]">{info.value}</div>
              <div class="text-cream/70 text-[13px] mt-1 font-light">{info.detail}</div>
            </div>
          ))}
        </div>

        <div class="flex flex-col gap-3 pt-4 border-t border-cream/15">
          <div class="text-sand/50 text-[10px] uppercase tracking-[0.25em]">À proximité</div>
          <ul class="flex flex-col gap-1.5 text-sand/75 text-sm">
            <li><a href="https://golfduprieure.com/" target="_blank">Golf du Prieuré</a></li>
            <li><a href="https://chateaudelabucherie.com/fr/" target="_blank">Château de la Bûcherie</a></li>
            <li>Route des impressionnistes - Vétheuil</li>
            <li><a href="https://www.chateaudelarocheguyon.fr/" target="_blank">Château de La Roche-Guyon</a></li>
            <li><a href="https://claudemonetgiverny.fr/" target="_blank">Maison et jardins de Claude Monet</a></li>
            <li><a href="https://www.moulindefourges.com/" target="_blank">Moulin de Fourges</a></li>
          </ul>
        </div>

        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-auto inline-flex items-center justify-between gap-3 bg-cream hover:bg-blush text-forest-deep px-6 py-4 rounded-full text-[11px] uppercase tracking-[0.28em] font-medium transition-colors relative"
        >
          Itinéraire
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7.5 3.5M11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
