---
const items = [
  "Vexin français",
  "Chevaux en liberté",
  "Yoga & équitation",
  "Balades nature",
  "EVJF & événements",
  "Demande en mariage",
  "Faune sauvage",
  "Ornithologie",
]
const repeated = [...items, ...items, ...items]
---

<div class="bg-forest-deep text-sand py-6 overflow-hidden border-y border-cream/8" aria-hidden="true">
  <div class="flex gap-14 whitespace-nowrap animate-marquee items-center">
    {repeated.map((item) => (
      <>
        <span class="font-display italic text-[28px]">{item}</span>
        <span class="text-blush text-lg">✦</span>
      </>
    ))}
  </div>
</div>
