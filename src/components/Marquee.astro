---
const items = [
  "Vexin français",
  "Chevaux en liberté",
  "Yoga & équitation",
  "Balades nature",
  "EVJF & événements",
  "Demande en mariage",
  "Faune sauvage",
  "Ornithologie",
]
const repeated = [...items, ...items]
---

<div class="bg-forest-deep text-sand py-6 overflow-hidden border-y border-cream/8" aria-hidden="true">
  
  <div class="marquee-track">
     {[...items, ...items].map((item) => (
      <div class="marquee-item">
        <span class="font-display italic text-[28px]">{item}</span>
        <span class="text-blush text-lg">✦</span>
      </div>
    ))}
  </div>
</div>
