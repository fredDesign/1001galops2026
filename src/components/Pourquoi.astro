---
const evenements = [
  {
    num: "01",
    image: "/images/evjf.jpg",
    alt: "Groupe d'amis à cheval, célébrant un EVJF en forêt",
    title: "EVJF / EVG",
    description: "Balade en groupe, possibilité de déguisements, d'une scéance yoga, ambiance conviviale. Une parenthèse nature et souvenirs pour célébrer avant le grand jour.",
    icon: `<path d="M24 8 C24 8 14 16 14 24 C14 29.5 18.5 34 24 34 C29.5 34 34 29.5 34 24 C34 16 24 8 24 8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M18 18 L24 8 L30 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    num: "02",
    image: "/images/mariage_2.jpg",
    alt: "Demande en mariage à cheval : un couple dans un cadre romantique, entouré de nature",
    title: "Demande en mariage",
    description: "Une balade à deux dans un cadre préservé, avec possibilité d'organisation personnalisée. Fleurs, champagne sans alcool, pause romantique au cœur du Vexin.",
    icon: `<path d="M24 38 L12 26 C9 23 9 18 12 15 C15 12 20 12 23 15 L24 16 L25 15 C28 12 33 12 36 15 C39 18 39 23 36 26 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>`,
  },
  {
    num: "03",
    image: "/images/formule.jpg",
    alt: "Pose Picnique à cheval : cavaliers assis sur des couvertures, entourés de paniers et de plats, dans une clairière ensoleillée",
    title: "Formule sur mesure",
    description: "Imaginez un moment unique : balade à cheval, pause pique-nique, yoga, séance photo, expérience bien-être. Tout est possible, sur mesure.",
    icon: `<circle cx="24" cy="24" r="16" stroke="currentColor" stroke-width="1.5"/><path d="M24 16 L26.5 21 L32 21.8 L28 25.7 L29 31.2 L24 28.5 L19 31.2 L20 25.7 L16 21.8 L21.5 21 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>`,
  }
]
---

<section id="evenements" class="bg-ivory text-forest-deep py-24 lg:py-36 relative overflow-hidden reveal" aria-labelledby="evenements-heading">
  <div
    class="absolute inset-0 opacity-[0.06] pointer-events-none"
    style="background-image:repeating-linear-gradient(135deg,#28718C 0 1px,transparent 1px 18px)"
    aria-hidden="true"
  ></div>

  <div class="max-w-[1400px] mx-auto px-6 lg:px-10 relative">

    <div class="grid lg:grid-cols-12 gap-10 items-end mb-16 lg:mb-20">
      <div class="lg:col-span-7">
        <div class="flex items-center gap-3 text-forest/70 text-[11px] uppercase tracking-[0.32em] mb-6 font-medium">
          <span class="w-10 h-[1px] bg-terra shrink-0"></span>
          <span>Vivre c'est célébrer et partager</span>
        </div>
        <h2 id="evenements-heading" class="font-display text-[clamp(40px,7vw,108px)] leading-[0.95] tracking-tight">
          Des moments<br/>
          <span class="font-editorial  text-forest">à célébrer.</span>
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <p class="text-forest-deep/75 text-base lg:text-lg leading-relaxed font-light">
          1001galops propose des expériences privatisées pour les moments qui comptent. Chaque formule est pensée pour créer un souvenir hors du commun.
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-1 lg:grid-cols-3 gap-5 lg:gap-6">
      {evenements.map((e) => (
        <div class="bg-cream/70 backdrop-blur-sm border border-forest/12 rounded-[24px] p-4 lg:p-4 flex flex-col gap-4 hover:bg-cream hover:border-forest/25 transition-all duration-500">
          <figure class="w-full relative h-48 rounded-lg overflow-hidden">
            <span class="text-terra font-display  absolute top-0 left-0 text-2xl flex aspect-square rounded-md rounded-bl-none rounded-tr-none  w-12 h-12 items-center justify-center bg-white">{e.num}</span>
            <img
              src={e.image}
              alt={e.alt}
              class="w-full h-full object-cover rounded-lg mb-4 aspect-square"
              loading="lazy"
              />
          </figure>
          <h3 class="font-display text-[28px] lg:text-[32px] leading-[1.05] tracking-tight">{e.title}</h3>
          <p class="text-forest-deep/65 leading-relaxed text-[13.5px] font-light ">{e.description}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 flex justify-center">
      <a
        href="#contact"
        class="group inline-flex items-center gap-3 bg-forest hover:bg-forest-soft text-cream px-7 py-4 rounded-full text-[11px] uppercase tracking-[0.28em] font-medium transition-colors"
      >
        Organiser votre événement
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="group-hover:translate-x-1 transition-transform">
          <path d="M3 7h8m0 0L7.5 3.5M11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>
