---
import { LegalModals } from "./LegalModals"

const links = {
  experiences: [
    { label: "Balades", href: "#balades" },
    { label: "Yoga & équitation", href: "#yoga" },
    { label: "EVJF & Événements", href: "#evenements" },
    { label: "Demande en mariage", href: "#evenements" },
  ],
  apropos: [
    { label: "Qui suis-je", href: "#apropos" },
    { label: "Le lieu", href: "#lieu" },
    { label: "Galerie", href: "#galerie" },
    { label: "Avis", href: "#temoignages" },
  ],
}
---

<footer class="bg-forest-deep text-cream pt-20 pb-10" aria-label="Pied de page">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">

    <div class="grid grid-cols-2 sm:grid-cols-6  lg:grid-cols-12 gap-10 pb-14 border-b border-cream/10">

      <!-- Brand -->
      <div class="col-span-2 sm:col-span-6 lg:col-span-5">
        <div class="flex items-baseline gap-1.5 mb-5">
          <span class="font-display text-[36px] leading-none font-semibold uppercase text-cream">1001</span>
          <span class="font-display text-[36px] leading-none font-semibold uppercase text-blush">Galops</span>
        </div>
        <p class="text-sand/70 text-base leading-relaxed max-w-sm font-light">
          <span class="text-xl font-medium">S'évader, respirer, bouger à cheval.</span><br> 
          Près de chez vous, en pleine nature, toute l'année.
        </p>

      <div class="mt-8 flex flex-wrap items-center gap-5">
        <div class="h-16 flex items-center">
          <a href="https://www.yvelines.fr/" class="h-12 md:h-16" target="_blank" rel="noopener noreferrer">
            <img src="/images/partners/logo-yvelines.svg" alt="Yvelines" class="h-full w-auto object-contain opacity-75 hover:opacity-100 transition-opacity" />
          </a>
        </div>
        <div class="h-16 flex items-center">
          <a href="https://www.ffe.com/" class="h-12 md:h-16" target="_blank" rel="noopener noreferrer">
            <img src="/images/partners/logo-ffe.svg" alt="Fédération Française d'Équitation" class="h-full w-auto object-contain opacity-75 hover:opacity-100 transition-opacity" />
          </a>
        </div>
        <div class="h-16 flex items-center">
          <a href="https://www.parcduvexin.fr/" class="h-12 md:h-16" target="_blank" rel="noopener noreferrer">
            <img src="/images/partners/logo-terre-de-seine.svg" alt="Terre de Seine" class="h-full w-auto object-contain opacity-75 hover:opacity-100 transition-opacity" />
          </a>
        </div>
        <div class="h-16 flex items-center">
          <a href="https://www.terres-de-seine.fr/" class="h-12 md:h-16" target="_blank" rel="noopener noreferrer">
            <img src="/images/partners/logo-vexin.svg" alt="Parc naturel régional du Vexin français" class="h-full w-auto object-contain opacity-75 hover:opacity-100 transition-opacity" />
          </a>
        </div>
      </div>
      </div>

      <!-- Expériences -->
      <div class="col-span-1 sm:col-span-2 lg:col-span-2">
        <div class="text-sand/50 text-[10px] uppercase tracking-[0.25em] mb-4">Expériences</div>
        <ul class="flex flex-col gap-3 text-cream/85 text-sm">
          {links.experiences.map((l) => (
            <li><a class="hover:text-blush transition-colors" href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- À propos -->
      <div class="col-span-1 sm:col-span-2 lg:col-span-2">
        <div class="text-sand/50 text-[10px] uppercase tracking-[0.25em] mb-4">À propos</div>
        <ul class="flex flex-col gap-3 text-cream/85 text-sm">
          {links.apropos.map((l) => (
            <li><a class="hover:text-blush transition-colors" href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="col-span-2 sm:col-span-2 lg:col-span-3">
        <div class="text-sand/50 text-[10px] uppercase tracking-[0.25em] mb-4">Contact</div>
        <address class="not-italic flex flex-col gap-3 text-cream/85 text-sm">
          <a href="mailto:contact@1001galops.fr" class="hover:text-blush transition-colors">contact@1001galops.fr</a>
          <a href="tel:+33678536430" class="hover:text-blush transition-colors">+33 6 78 53 64 30</a>
          <span>1001galops<br/>78440 Drocourt</span>
        </address>
        <div class="flex gap-3 mt-5" aria-label="Réseaux sociaux">
          <a
            href="https://facebook.com/1001galops"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full border border-cream/20 hover:border-blush hover:text-blush flex items-center justify-center text-[10px] tracking-wider transition-colors"
            aria-label="Facebook"
          >FB</a> <span class="sr-only">Facebook</span>
        </div>
      </div>
    </div>

    <!-- Legal -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 pt-8 text-[12px] text-sand/50">
      <div class="flex items-baseline gap-1.5">
        <div class="logo_text flex gap-1">
          <span class="font-display font-semibold uppercase text-xl text-cream">1001</span>
          <span class="font-display font-semibold uppercase text-xl text-blush">Galops</span>
        </div>
        <span class="ml-3">© 2026 — Tous droits réservés</span>
      </div>
      <LegalModals client:load />
    </div>
  </div>
</footer>
