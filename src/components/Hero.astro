---
import HeroBodyDefault from "@/components/HeroBodyDefault.astro"

interface Props {
  tagline?: string
  taglineAccent?: string
  description?: string
  ctaPrimaryLabel?: string
  ctaPrimaryHref?: string
  ctaSecondaryLabel?: string
  ctaSecondaryHref?: string
  ariaLabel?: string
  body?: typeof HeroBodyDefault
}

const {
  tagline = "Une parenthèse à cheval,",
  taglineAccent = "au cœur du Vexin.",
  ariaLabel = "Accueil",
  body: Body = HeroBodyDefault,
  description,
  ctaPrimaryLabel,
  ctaPrimaryHref,
  ctaSecondaryLabel,
  ctaSecondaryHref,
} = Astro.props
---

<section class="relative min-h-screen w-full overflow-hidden bg-forest-deep" aria-label={ariaLabel}>
  <div class="absolute inset-0">
    <img
      src="/images/hero-cheval-foret.webp"
      alt="Cavalière au galop dans la forêt"
      class="w-full h-full object-cover"
      fetchpriority="high"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-forest-deep/55 via-forest-deep/20 to-forest-deep/95"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-forest-deep/55 via-transparent to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-10 pt-36 pb-16 min-h-screen flex flex-col justify-between">

    <!-- Logo + tagline -->
    <div class="flex items-center flex-col lg:flex-row justify-center md:justify-start gap-5 pt-8">
      <div class="bg-white rounded-full shadow-2xl shadow-black/40 flex items-center justify-center w-[240px] h-[240px] aspect-[1/1]">
        <img src="/images/logo-1001galops_bg.png" alt="Logo 1001 Galops" class="w-full">
      </div>
        <h1 class="text-cream text-center lg:text-start leading-[0.92] font-semibold tracking-tight font-display">
          <span class="block text-[clamp(44px,7.5vw,72px)]">{tagline}</span>
          <span class="block italic text-[clamp(44px,7.5vw,72px)] text-white">{taglineAccent}</span>
        </h1>
    </div>

    <Body
      description={description}
      ctaPrimaryLabel={ctaPrimaryLabel}
      ctaPrimaryHref={ctaPrimaryHref}
      ctaSecondaryLabel={ctaSecondaryLabel}
      ctaSecondaryHref={ctaSecondaryHref}
    />
  </div>


</section>
