              class="group relative bg-cream border border-forest/12 rounded-[28px] overflow-hidden flex flex-col hover:-translate-y-1 hover:border-forest/25 hover:shadow-[0_30px_60px_-30px_rgba(40,113,140,0.25)] transition-all duration-500 h-full"
