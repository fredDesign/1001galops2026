                    <div class="absolute bottom-0 inset-x-0 bg-linear-to-t from-forest-deep/70 to-transparent px-6 pb-5 pt-10">
                      {s.link ? (
                        <a href={s.link} class="font-display italic text-cream text-2xl hover:text-blush transition-colors">
                          {s.title} →
                        </a>
                      ) : (
                        <span class="font-display italic text-cream text-2xl">{s.title}</span>
                      )}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
          <div class="absolute bottom-4 inset-x-0 flex justify-center gap-2 z-10">
            {carousel.map((_, i) => (
              <button class="embla-balades__dot w-2 h-2 rounded-full bg-cream/40 transition-all duration-300" aria-label={`Image ${i + 1}`}></button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import EmblaCarousel from 'embla-carousel'
  import type { EmblaCarouselType } from 'embla-carousel'

  const expNode = document.querySelector<HTMLElement>('.embla-exp')
  const prevBtn = document.querySelector<HTMLButtonElement>('.embla-exp__prev')
  const nextBtn = document.querySelector<HTMLButtonElement>('.embla-exp__next')

  if (expNode) {
    let embla: EmblaCarouselType | null = null

    const updateButtons = () => {
      prevBtn?.toggleAttribute('disabled', !embla?.canScrollPrev())
      nextBtn?.toggleAttribute('disabled', !embla?.canScrollNext())
    }

    const mq = window.matchMedia('(min-width: 768px)')

    const sync = (isMd: boolean) => {
      if (isMd && !embla) {
        embla = EmblaCarousel(expNode, { loop: false, align: 'start' })
        prevBtn?.addEventListener('click', () => embla?.scrollPrev())
        nextBtn?.addEventListener('click', () => embla?.scrollNext())
        embla.on('select', updateButtons)
        embla.on('reInit', updateButtons)
        updateButtons()
      } else if (!isMd && embla) {
        embla.destroy()
        embla = null
      }
    }

    sync(mq.matches)
    mq.addEventListener('change', (e) => sync(e.matches))
  }
</script>

<script>
  import EmblaCarousel from 'embla-carousel'
  import Fade from 'embla-carousel-fade'
  import Autoplay from 'embla-carousel-autoplay'

  const viewport = document.querySelector<HTMLElement>('.embla-balades__viewport')
  const dots = document.querySelectorAll<HTMLButtonElement>('.embla-balades__dot')

  if (viewport) {
    const embla = EmblaCarousel(viewport, { loop: true }, [
      Fade(),
      Autoplay({ delay: 3500, stopOnInteraction: false }),
    ])

    const updateDots = () => {
      const idx = embla.selectedScrollSnap()
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-cream', i === idx)
        dot.classList.toggle('scale-125', i === idx)
        dot.classList.toggle('bg-cream/40', i !== idx)
      })
    }

    embla.on('select', updateDots)
    updateDots()

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => embla.scrollTo(i))
    })
  }
</script>
