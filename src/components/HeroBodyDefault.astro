---
interface Props {
  description?: string
  ctaPrimaryLabel?: string
  ctaPrimaryHref?: string
  ctaSecondaryLabel?: string
  ctaSecondaryHref?: string
}

const {
  description = "Balades à cheval, expériences nature,<br> évenements & yoga équitation. <br> 1001galops vous invite à vivre l'équitation\nautrement..",
  ctaPrimaryLabel = "Réserver une balade",
  ctaPrimaryHref = "#contact",
  ctaSecondaryLabel = "Découvrir",
  ctaSecondaryHref = "#balades",
} = Astro.props
---

<!-- Main heading -->
<div class="max-w-[1100px] mt-auto">
  <div class="flex flex-col items-center lg:flex-row lg:items-end lg:justify-between gap-8 mt-10">
    <p class="text-cream/85 text-base text-center lg:text-start text-xl lg:text-2xl max-w-2xl lg:leading-relaxed" set:html={description} />
    <div class="flex flex-col sm:flex-row gap-3">
      <a
        href={ctaPrimaryHref}
        class="group inline-flex items-center justify-center gap-3 bg-cream hover:bg-blush text-forest-deep px-7 py-4 rounded-full text-[11px] uppercase tracking-[0.28em] font-medium transition-colors"
      >
        {ctaPrimaryLabel}
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="group-hover:translate-x-1 transition-transform">
          <path d="M3 7h8m0 0L7.5 3.5M11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>
      <a
        href={ctaSecondaryHref}
        class="inline-flex items-center justify-center gap-3 border border-cream/35 hover:border-cream text-cream px-7 py-4 rounded-full text-[11px] uppercase tracking-[0.28em] font-light transition-colors backdrop-blur-sm"
      >
        {ctaSecondaryLabel}
      </a>
    </div>
  </div>
</div>

<!-- Stats -->
<div class="grid grid-cols-2 md:grid-cols-8 lg:grid-cols-8 gap-6 mt-14 pt-8 border-t border-cream/15">
  <div class="col-span-1 md:col-span-2 lg:col-span-2">
    <div class="font-display text-cream text-4xl md:text-5xl leading-none">Vexin <span class="text-2xl">Français</span></div>
    <div class="text-cream/55 text-[10px] uppercase tracking-[0.28em] mt-2 font-light">Parc naturel régional</div>
  </div>
  <div class="col-span-1 md:col-span-2 lg:col-span-2">
    <div class="font-display text-cream text-4xl md:text-5xl leading-none">45<span class="text-base font-light">min</span></div>
    <div class="text-cream/55 text-[10px] uppercase tracking-[0.28em] mt-2 font-light">depuis Paris</div>
  </div>
  <div class="col-span-1 md:col-span-1 lg:col-span-1">
    <div class="font-display text-cream text-4xl md:text-5xl leading-none">7<span class="text-base font-light">/7</span></div>
    <div class="text-cream/55 text-[10px] uppercase tracking-[0.28em] mt-2 font-light">sur réservation</div>
  </div>
  <div class="col-span-1 md:col-span-3 lg:col-span-3 align-items-end">
    <div class="font-display text-cream text-2xl sm:text-3xl md:text-5xl leading-1.2 md:leading-none md:text-end">
      <a href="tel:+33678536430" class="text-cream hover:text-blush">06.78.53.64.30</a>
    </div>
    <div class="text-cream/55 text-[10px] uppercase tracking-[0.28em] mt-2 font-light md:text-end">Plus d'informations</div>
  </div>
</div>
